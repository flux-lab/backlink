<script>     
    /******** DARK MODE TOUR BOX ********/
    const btnthree = document.querySelector(".darkMode-three");
    btnthree.addEventListener("click", function() {
      document.body.classList.toggle("darkModeActive");
      if (document.body.classList.contains("darkModeActive")) {
        document.cookie = "theme%3ddark%3b%20path%3d/index.html";    
      }
      else {
        document.cookie = "theme%3dlight%3b%20path%3d/index.html";          
      }
    });    
    if (sessionStorage.getItem('darkOnce') !== 'true') {
        var hourtime = new Date().getHours();
        if (document.body.classList.contains("darkModeActive")) {
            $('.darkMode').removeClass('z-index-9');            
        }
        else if (hourtime >= 18 && hourtime <= 24) {
            setTimeout(function(){
                $('.body-color-overlay2').fadeIn();       
                $('.bottom').slideDown('slow');
                $('.darkMode').addClass('z-index-9');
            }, 5000); 
        }        
        else {
            $('.darkMode').removeClass('z-index-9');
        }       
        sessionStorage.setItem('darkOnce','true');
    }  
    setTimeout(function() { sessionStorage.clear(); }, (1000 * 60 * 60 * 2));  // Clear value after every 2 hours  
    $('.darkMode').click(function() {
        $('.bottom').addClass('d-none');
        $('.body-color-overlay2').addClass('d-none');
        $('.darkMode').removeClass('z-index-9');
    });        
    $('.custom-tooltip .tooltip-close').on('click',function(){
        $('.bottom').addClass('d-none');
        $('.body-color-overlay2').addClass('d-none');
        $('.darkMode').removeClass('z-index-9');        
    });
  
</script>

