<script>
    $(function (){
        $("body").on("click",".plnclick",function (){

            let id  = $(this).attr("data-id");

            $(".plnclick[data-id!="+id+"]").removeClass("casc-active");
            $(".plnclick[data-id="+id+"]").addClass("casc-active");


            $(".planed[data-id!="+id+"]").hide();
            $(".planed[data-id="+id+"]").show();

        });

    })
</script>
